x}\ncaption{text-align:left;font-size:13px;color:var(--muted);padding:10px 14px;border-bottom:2px solid var(--line);background:var(--soft)}\nth,td{padding:12px 14px;text-align:left;vertical-align:top;border-bottom:1px solid #d9d1c8}\nthead th{background:var(--ink);color:#fff;font-size:13px;letter-spacing:.06em;border-bottom:2px solid var(--line)}\nthead th.featured-col{background:var(--orange)}\ntbody th{font-weight:700;font-size:13.5px;background:var(--soft);width:132px}\ntbody tr:last-child th,\ntbody tr:last-child td{border-bottom:none}\ntd .price{display:block;font-size:18px;font-weight:800;line-height:1.3}\ntd .annual{display:block;font-size:12.5px;color:var(--muted)}\ntd.featured-col{background:#fff3ec}\n.yes{font-weight:700}\n.plan-note{font-size:13px;color:var(--muted);margin-top:12px;max-width:44em}\n\n/* 客户端区块 */\n.client-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:22px}\n.client{border:2px solid var(--line);padding:16px}\n.client h3{font-size:15.5px;font-weight:800;margin-bottom:6px}\n.client p{font-size:14px;margin:0 0 8px;color:#3b332d}\n.client p:last-child{margin-bottom:0}\n.client .meta{font-size:12px;letter-spacing:.1em;color:var(--muted);text-transform:uppercase}\n\n/* FAQ 双栏问答 */\n.faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 22px;margin-top:22px}\n.qa{border-top:2px solid var(--line);padding-top:12px}\n.qa h3{font-size:15.5px;font-weight:800;margin-bottom:6px}\n.qa h3::before{content:\"问\";display:inline-block;width:20px;height:20px;line-height:20px;text-align:center;font-size:11px;background:var(--orange);color:#fff;margin-right:8px;vertical-align:2px}\n.qa p{font-size:14px;margin:0;color:#3b332d}\n.qa p::before{content:\"答\";display:inline-block;width:20px;height:20px;line-height:20px;text-align:center;font-size:11px;border:2px solid var(--line);margin-right:8px;vertical-align:2px}\n\n.closing{margin-top:44px;border:2px solid var(--line);background:var(--ink);color:#fff;padding:22px 20px}\n.closing h2{font-size:20px;margin-bottom:8px;color:#fff}\n.closing p{font-size:14px;margin:0;color:#e6ded6;max-width:40em}\n\nfooter{border-top:2px solid var(--line);margin-top:34px;padding:18px 0 0;font-size:12.5px;color:var(--muted);display:flex;flex-wrap:wrap;gap:6px 18px}\n\n@media (max-width:900px){\n  .cards{grid-template-columns:repeat(2,minmax(0,1fr))}\n}\n@media (max-width:760px){\n  .shell{grid-template-columns:1fr;padding:0 16px}\n  .sidenav{position:static;max-height:none;border-right:none;border-bottom:2px solid var(--line);padding:20px 0 16px}\n  .sidenav ol{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:4px}\n  .sidenav li{margin-bottom:0}\n  .sidenav li a{padding-left:22px;font-size:13px}\n  .sidenav .note{display:none}\n  .cards,\n  .client-row,\n  .faq-grid{grid-template-columns:1fr}\n  .hero{padding-top:24px}\n  section{padding-top:34px;margin-top:26px}\n}\n</style><div class=\"shell\">\n\n  <nav class=\"sidenav\" aria-label=\"页面目录\">\n    <a class=\"mark\" href=\"#top\">快薄荷<span>.</span></a>\n    <span class=\"sub\">Famint</span>\n    <ol>\n      <li><a href=\"#start\">先看这三步</a></li>\n      <li><a href=\"#read\">看页前的小提示</a></li>\n      <li><a href=\"#plans\">套餐对照</a></li>\n      <li><a href=\"#clients\">客户端与设备</a></li>\n      <li><a href=\"#faq\">常见问题</a></li>\n    </ol>\n    <p class=\"note\">这一页只做一件事：把已知信息摆清楚，不夸大，也不替你下结论。</p>\n  </nav>\n\n  <main id=\"top\">\n\n    <header class=\"hero\">\n      <span class=\"hero-kicker\">快薄荷 Famint · 订阅说明</span>\n      <h1>快薄荷(Famint) · 别急着下单，<br>先跟着<em>时间线</em>走一遍。</h1>\n      <p class=\"hero-lead\">你好，这里是快薄荷。我们知道订阅页最容易写成一串漂亮形容词，于是反过来做：把买之前真正会遇到的几个节点，按顺序讲一遍。看完再决定，一点都不迟。</p>\n\n      <ol class=\"timeline\">\n        <li>\n          <span class=\"tl-step\">节点一 · 认识一下</span>\n          <h3>先弄清这页在讲什么</h3>\n          <p>快薄荷（Famint）的订阅说明页。下方列出套餐、档位差异、客户端使用思路和常见问题，内容以本页展示为准，没写的部分我们不会替你想象。</p>\n        </li>\n        <li>\n          <span class=\"tl-step\">节点二 · 对一下账</span>\n          <h3>把你的用量和设备数写下来</h3>\n          <p>一个人用、两个人用、家里几台设备，这三件事决定了你该看哪一档。别按价格挑，按用量挑，后面会省心很多。</p>\n        </li>\n        <li>\n          <span class=\"tl-step\">节点三 · 横向比较</span>\n          <h3>打开套餐表格，只比差异</h3>\n          <p>三档套餐的差别集中在流量、设备台数和附加服务上。表格已经按行对齐，你只需要沿着同一行往右看。</p>\n        </li>\n        <li>\n          <span class=\"tl-step\">节点四 · 落地使用</span>\n          <h3>挑一个你顺手的客户端</h3>\n          <p>订阅到手之后，日常体验更多取决于你用什么设备、什么习惯。客户端区块给的是选择思路，而不是只能照做的标准答案。</p>\n        </li>\n        <li>\n          <span class=\"tl-step\">节点五 · 留个后路</span>\n          <h3>把疑问在付款前问完</h3>\n          <p>常见问题里放了我们在沟通中最常被问到的那几件事。如果还有没覆盖到的，先记下来，别含糊过去。</p>\n        </li>\n      </ol>\n    </header>\n\n    <section id=\"read\">\n      <span class=\"sec-num\">01 / 使用说明</span>\n      <h2>看这页之前，三句话就够</h2>\n      <p class=\"sec-intro\">我们尽量把话说得软一点，但信息还是要有边界。以下三条，帮你判断这页内容能回答你什么、不能回答你什么。</p>\n      <div class=\"cards\">\n        <article class=\"card\">\n          <span class=\"tag\">信息范围</span>\n          <h3>只写我们确认过的</h3>\n          <p>页面中的套餐名称、价格、流量额度与设备台数都来自现有档位设置。未列出的性能指标、节点分布与运行数据，本页不作描述。</p>\n        </article>\n        <article class=\"card is-orange\">\n          <span class=\"tag\">费用口径</span>\n          <h3>月付与年付分两行看</h3>\n          <p>表格里同时给出月付价格与按年付折算价，两者并列展示，方便你按自己的使用周期做取舍，不做捆绑暗示。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"tag\">使用边界</span>\n          <h3>请按所在地规定使用</h3>\n          <p>订阅只是工具，怎么用、在哪里用、用来做什么，需要你自己判断并遵守当地法律法规与服务条款。</p>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"plans\">\n      <span class=\"sec-num\">02 / 套餐对照</span>\n      <h2>三档套餐，横向摆开对比</h2>\n      <p class=\"sec-intro\">横向对比的好处是不用上下翻。先看“每月流量”这一行，再看“同时在线设备”这一行，通常到这里你就有答案了。</p>\n\n      <div class=\"table-wrap\">\n        <table>\n          价格为页面展示档位，年付为按年一次性支付的折算展示，实际结算信息以你下单时看到的为准。\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>基础版</th>\n              <th class=\"featured-col\">旗舰版</th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td><span class=\"price\">¥15/月</span></td>\n              <td class=\"featured-col\"><span class=\"price\">¥35/月</span></td>\n              <td><span class=\"price\">¥85/月</span></td>\n            </tr>\n            <tr>\n              <th>按年付</th>\n              <td><span class=\"annual\">¥150/年</span></td>\n              <td class=\"featured-col\"><span class=\"annual\">¥350/年</span></td>\n              <td><span class=\"annual\">¥850/年</span></td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td class=\"featured-col\">300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"featured-col\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体相关</th>\n              <td>基础流媒体解锁</td>\n              <td class=\"featured-col\">全节点原生流媒体解锁</td>\n              <td>随套餐档位提供</td>\n            </tr>\n            <tr>\n              <th>线路与优化</th>\n              <td>普通线路节点池</td>\n              <td class=\"featured-col\">IPLC 专线游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>附加服务</th>\n              <td>—</td>\n              <td class=\"featured-col\">7x24 优先工单支持</td>\n              <td>企业定制路由、专属客户经理</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>一个人用，设备不多</td>\n              <td class=\"featured-col\">一两人共用，还玩游戏</td>\n              <td>小团队或家里设备较杂</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"plan-note\">表格中“适合谁”是我们对档位差异的一句口头归纳，不是使用承诺。团队版的定制路由与客户经理属于需沟通的条目，具体能否落地，请在付款前先问清楚。</p>\n    </section>\n\n    <section id=\"clients\">\n      <span class=\"sec-num\">03 / 客户端与设备</span>\n      <h2>设备不同，选择思路也不同</h2>\n      <p class=\"sec-intro\">我们不在这里塞下载地址，因为本页拿不到可靠的官方来源。下面只讲选择思路，具体安装包请以你信任的官方渠道为准。</p>\n\n      <div class=\"client-row\">\n        <article class=\"client\">\n          <span class=\"meta\">桌面端</span>\n          <h3>电脑上，先用你系统自带的习惯</h3>\n          <p>Windows 与 macOS 上可选的客户端类型较多，优先选你愿意长期维护、能自行核查来源的那一个。装之前看一眼版本号与发布方，比装完再折腾省事。</p>\n          <p>桌面端适合长时间在线的场景，也因为屏幕大，更容易看清当前连接状态与用量。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"meta\">移动端</span>\n          <h3>手机上，把台数算进去</h3>\n          <p>手机和平板通常算作独立设备。如果你的设备数接近当前档位上限，与其反复登出登入，不如直接看高一档。</p>\n          <p>移动端使用时间零碎，流量消耗往往比预想更快，建议每周粗看一次用量。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"meta\">路由器 / 家庭场景</span>\n          <h3>一个账号，多个屏幕</h3>\n          <p>把连接放在路由器层面，家里多台设备共用会更省事，但设备台数的统计方式也可能因此变化，具体以你实际看到的为准。</p>\n          <p>如果家里有电视、游戏主机这类设备，建议先确认它们在不在你的台数预算里。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"meta\">临时与备用</span>\n          <h3>给自己留一个 Plan B</h3>\n          <p>出差、换网络、临时借用别人的电脑，这些情况都会遇到。提前想好一个备用方式，通常比临时找教程更从容。</p>\n          <p>无论用哪个客户端，请避免把订阅信息随手转发给他人，这是最基本的一条。</p>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <span class=\"sec-num\">04 / 常见问题</span>\n      <h2>几个被问得最多的问题</h2>\n      <p class=\"sec-intro\">双栏并排，左边偏“买之前”，右边偏“买之后”。对号入座就好。</p>\n\n      <div class=\"faq-grid\">\n        <div class=\"qa\">\n          <h3>三档套餐，我到底该怎么选？</h3>\n          <p>只看两个数字：每月流量和同时在线设备。基础版适合一个人、设备控制在 3 台以内；旗舰版适合一两个人共用、偶尔玩游戏；团队版面向设备多、需要定制路由的场景。超出这两项再考虑其他差异。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>年付一定比月付划算吗？</h3>\n          <p>从页面展示的折算价看，年付确实更低。但划算与否取决于你会不会用满一年。如果你只是短期试试，或者用量不稳定，先按月付走，等确认顺手了再考虑年付，我们不会催你。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>流量当月用不完，能留到下个月吗？</h3>\n          <p>本页没有关于流量结转的规则说明，所以我们不能替你承诺可以或不可以。建议在付款前直接向服务方确认这一条，得到明确答复后再决定。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>“普通线路节点池”和“IPLC 专线”差别在哪？</h3>\n          <p>按页面展示，基础版使用普通线路节点池，旗舰版包含 IPLC 专线的游戏加速优化，团队版提供 VIP 专属高带宽节点。本页不提供线路数量、延迟或稳定性数据，具体表现请以你的实际使用环境为准。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>设备台数怎么算？换设备要重新买吗？</h3>\n          <p>各档位分别标注了 3 台、5 台、20 台的同时在线设备数，指的是同一时间在线的设备数量。是否为“替换登录”还是“新增占用”，本页没有细则，请向服务方核实后再安排你的设备。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>你们提供客户端下载链接吗？</h3>\n          <p>本页不提供。我们没有可靠的官方来源可以直接链接，与其给你一个可能过期的地址，不如请你从自己确认可信的官方渠道获取，并核对发布方与版本信息。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>团队版的定制路由和客户经理，怎么落地？</h3>\n          <p>这两项属于需要沟通的条目，不在页面上自助完成。建议在订阅团队版之前，先把你的网络结构、设备情况和期望讲清楚，确认可以做到什么程度，再付款。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>用起来不顺手，能退吗？</h3>\n          <p>本页没有可依据的退款条款，我们不能凭印象给你一个“可以”或“不可以”。请在下单前找到并读完正式条款，把退费条件、时限和处理方式问明白，这是对自己负责。</p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"start\">\n      <span class=\"sec-num\">05 / 下一步</span>\n      <h2>如果你已经想清楚了</h2>\n      <p class=\"sec-intro\">那就按顺序做三件小事，不需要额外准备什么：</p>\n      <ul>\n        <li>写下你要用的设备清单，和每月大致的流量区间。</li>\n        <li>回到套餐表格，沿同一行横向对比，只挑满足条件的最低那一档。</li>\n        <li>把还没确定的问题列出来，先问清楚，再决定月付还是年付。</li>\n      </ul>\n      <div class=\"closing\">\n        <h2>慢慢来，我们不差这一会儿</h2>\n        <p>订阅是长期使用的事，多花十分钟把信息看明白，比事后反复调整要划算。页面内容会随档位调整而更新，以你当下看到的版本为准。</p>\n      </div>\n    </section>\n\n    <footer>\n      <span>快薄荷 Famint</span>\n      <span>本页为订阅说明，价格与权益以页面展示档位为准</span>\n      <span>请遵守所在地法律法规与服务条款</span>\n    </footer>\n\n  </main>\n</div>",
